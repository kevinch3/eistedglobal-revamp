{
  "name": "eistedglobal-api",
  "version": "1.0.0",
  "description": "Eistedglobal REST API - Express.js + TypeScript + SQLite",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc && npm run copy:schema",
    "start": "node dist/server.js",
    "seed": "ts-node src/config/seed.ts",
    "seed:demo": "ts-node src/config/seed.demo.ts",
    "migrate": "ts-node src/config/migrate.ts",
    "postinstall": "npm rebuild better-sqlite3",
    "copy:schema": "node -e \"require('fs').mkdirSync('dist/config',{recursive:true});require('fs').copyFileSync('src/config/schema.sql','dist/config/schema.sql')\"",
    "contract:lint": "redocly lint",
    "contract:routes": "ts-node --transpile-only scripts/check-spec-routes.ts",
    "contract:check": "npm run contract:lint && npm run contract:routes"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "@redocly/cli": "^1.25.0"
  }
}
